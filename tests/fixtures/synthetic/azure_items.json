{
  "_label": "synthetic",
  "_note": "Invented Azure-shaped items with known answers. Each case overrides `set` keys and removes `drop` keys from `base`; `replace` swaps the whole item. IDs are placeholders and prices are round invented numbers.",
  "base": {
    "currencyCode": "USD",
    "tierMinimumUnits": 0.0,
    "retailPrice": 7.0,
    "unitPrice": 7.0,
    "armRegionName": "eastus",
    "location": "US East",
    "effectiveStartDate": "2026-01-01T00:00:00Z",
    "meterId": "00000000-0000-0000-0000-000000000001",
    "meterName": "NC40ads H100 v5",
    "productId": "SYNTH0001",
    "skuId": "SYNTH0001/0001",
    "productName": "Virtual Machines NCadsH100v5 Series",
    "skuName": "NC40ads H100 v5",
    "serviceName": "Virtual Machines",
    "serviceId": "SYNTHSVC1",
    "serviceFamily": "Compute",
    "unitOfMeasure": "1 Hour",
    "type": "Consumption",
    "isPrimaryMeterRegion": true,
    "armSkuName": "Standard_NC40ads_H100_v5"
  },
  "cases": [
    {"name": "pay-as-you-go", "kind": "normal", "set": {},
     "expect": {"outcome": "stored", "rental_type": "on_demand", "price_unit": "1 Hour", "flags": [],
                "item_key": "00000000-0000-0000-0000-000000000001|SYNTH0001/0001|eastus|Consumption||0.0|USD|Standard_NC40ads_H100_v5"}},
    {"name": "spot", "kind": "normal", "set": {"meterName": "NC40ads H100 v5 Spot", "skuName": "NC40ads H100 v5 Spot", "retailPrice": 2.5},
     "expect": {"outcome": "stored", "rental_type": "spot", "price_unit": "1 Hour", "flags": []}},
    {"name": "reservation names its term", "kind": "normal",
     "set": {"type": "Reservation", "reservationTerm": "1 Year", "retailPrice": 25007.0, "unitPrice": 25007.0},
     "expect": {"outcome": "stored", "rental_type": "reservation", "price_unit": "1 Year term", "flags": [],
                "item_key": "00000000-0000-0000-0000-000000000001|SYNTH0001/0001|eastus|Reservation|1 Year|0.0|USD|Standard_NC40ads_H100_v5"}},
    {"name": "spot on a dev/test row", "kind": "edge",
     "set": {"type": "DevTestConsumption", "meterName": "NC40ads H100 v5 Spot", "skuName": "NC40ads H100 v5 Spot"},
     "expect": {"outcome": "stored", "rental_type": "dev_test", "price_unit": "1 Hour", "flags": []}},
    {"name": "low priority", "kind": "edge",
     "set": {"meterName": "NC40ads H100 v5 Low Priority", "skuName": "NC40ads H100 v5 Low Priority"},
     "expect": {"outcome": "stored", "rental_type": "other", "price_unit": "1 Hour", "flags": []}},
    {"name": "names disagree about spot", "kind": "edge", "set": {"meterName": "NC40ads H100 v5 Spot"},
     "expect": {"outcome": "stored", "rental_type": "other", "price_unit": "1 Hour", "flags": ["rental_type_ambiguous"]}},
    {"name": "unknown price type", "kind": "edge", "set": {"type": "Rental"},
     "expect": {"outcome": "stored", "rental_type": "other", "price_unit": "1 Hour", "flags": ["unknown_price_type"]}},
    {"name": "savings plan stays on its row", "kind": "edge",
     "set": {"savingsPlan": [{"unitPrice": 4.0, "retailPrice": 4.0, "term": "3 Years"}, {"unitPrice": 5.5, "retailPrice": 5.5, "term": "1 Year"}]},
     "expect": {"outcome": "stored", "rental_type": "on_demand", "price_unit": "1 Hour", "flags": [],
                "savings_plan": "[{\"unitPrice\":4.0,\"retailPrice\":4.0,\"term\":\"3 Years\"},{\"unitPrice\":5.5,\"retailPrice\":5.5,\"term\":\"1 Year\"}]"}},
    {"name": "non-hourly unit flagged", "kind": "edge", "set": {"unitOfMeasure": "1/Month"},
     "expect": {"outcome": "stored", "rental_type": "on_demand", "price_unit": "1/Month", "flags": ["unit_not_hourly"]}},
    {"name": "AMD in the ND family", "kind": "edge", "set": {"armSkuName": "Standard_ND96isr_MI300X_v5"},
     "expect": {"outcome": "stored", "rental_type": "on_demand", "price_unit": "1 Hour", "flags": []}},
    {"name": "fractional NV size", "kind": "edge", "set": {"armSkuName": "Standard_NV6ads_A10_v5"},
     "expect": {"outcome": "stored", "rental_type": "on_demand", "price_unit": "1 Hour", "flags": []}},
    {"name": "NG family", "kind": "edge", "set": {"armSkuName": "Standard_NG8ads_V620_v1"},
     "expect": {"outcome": "stored", "rental_type": "on_demand", "price_unit": "1 Hour", "flags": []}},
    {"name": "optional fields absent", "kind": "edge", "drop": ["unitPrice", "effectiveStartDate", "location", "productId", "productName", "serviceName", "serviceFamily"],
     "expect": {"outcome": "stored", "rental_type": "on_demand", "price_unit": "1 Hour", "flags": []}},
    {"name": "FPGA size out of scope", "kind": "failing", "set": {"armSkuName": "Standard_NP20s"},
     "expect": {"outcome": "out_of_scope"}},
    {"name": "CPU size out of scope", "kind": "failing", "set": {"armSkuName": "Standard_E64_v4"},
     "expect": {"outcome": "out_of_scope"}},
    {"name": "out of scope beats a bad price", "kind": "failing", "set": {"armSkuName": "Standard_NP20s", "retailPrice": 0.0},
     "expect": {"outcome": "out_of_scope"}},
    {"name": "zero price", "kind": "failing", "set": {"retailPrice": 0.0},
     "expect": {"outcome": "rejected", "reason": "non_positive_price"}},
    {"name": "negative price", "kind": "failing", "set": {"retailPrice": -1.0},
     "expect": {"outcome": "rejected", "reason": "non_positive_price"}},
    {"name": "euro price", "kind": "failing", "set": {"currencyCode": "EUR"},
     "expect": {"outcome": "rejected", "reason": "non_usd_currency"}},
    {"name": "non-primary meter", "kind": "failing", "set": {"isPrimaryMeterRegion": false},
     "expect": {"outcome": "rejected", "reason": "not_primary_meter"}},
    {"name": "missing meter ID", "kind": "failing", "drop": ["meterId"],
     "expect": {"outcome": "rejected", "reason": "missing_field"}},
    {"name": "missing ARM SKU name", "kind": "failing", "drop": ["armSkuName"],
     "expect": {"outcome": "rejected", "reason": "missing_field"}},
    {"name": "missing tier minimum", "kind": "failing", "drop": ["tierMinimumUnits"],
     "expect": {"outcome": "rejected", "reason": "missing_field"}},
    {"name": "null primary flag", "kind": "failing", "set": {"isPrimaryMeterRegion": null},
     "expect": {"outcome": "rejected", "reason": "missing_field"}},
    {"name": "price as text", "kind": "failing", "set": {"retailPrice": "7.0"},
     "expect": {"outcome": "rejected", "reason": "invalid_value"}},
    {"name": "price as a boolean", "kind": "failing", "set": {"retailPrice": true},
     "expect": {"outcome": "rejected", "reason": "invalid_value"}},
    {"name": "primary flag as text", "kind": "failing", "set": {"isPrimaryMeterRegion": "true"},
     "expect": {"outcome": "rejected", "reason": "invalid_value"}},
    {"name": "empty region", "kind": "failing", "set": {"armRegionName": ""},
     "expect": {"outcome": "rejected", "reason": "invalid_value"}},
    {"name": "negative unit price", "kind": "failing", "set": {"unitPrice": -7.0},
     "expect": {"outcome": "rejected", "reason": "invalid_value"}},
    {"name": "unparseable start date", "kind": "failing", "set": {"effectiveStartDate": "yesterday"},
     "expect": {"outcome": "rejected", "reason": "invalid_value"}},
    {"name": "start date without a zone", "kind": "failing", "set": {"effectiveStartDate": "2026-01-01T00:00:00"},
     "expect": {"outcome": "rejected", "reason": "invalid_value"}},
    {"name": "start date as a number", "kind": "failing", "set": {"effectiveStartDate": 20260101},
     "expect": {"outcome": "rejected", "reason": "invalid_value"}},
    {"name": "empty ARM SKU name", "kind": "failing", "set": {"armSkuName": ""},
     "expect": {"outcome": "rejected", "reason": "invalid_value"}},
    {"name": "negative tier minimum", "kind": "failing", "set": {"tierMinimumUnits": -1.0},
     "expect": {"outcome": "rejected", "reason": "invalid_value"}},
    {"name": "location as a number", "kind": "failing", "set": {"location": 5},
     "expect": {"outcome": "rejected", "reason": "invalid_value"}},
    {"name": "savings plan not a list", "kind": "failing", "set": {"savingsPlan": "cheap"},
     "expect": {"outcome": "rejected", "reason": "invalid_value"}},
    {"name": "reservation without a term", "kind": "failing", "set": {"type": "Reservation", "retailPrice": 25007.0},
     "expect": {"outcome": "rejected", "reason": "reservation_without_term"}},
    {"name": "bar inside a key field", "kind": "failing", "set": {"skuId": "SYNTH0001|0001"},
     "expect": {"outcome": "rejected", "reason": "invalid_value"}},
    {"name": "item is not an object", "kind": "failing", "replace": ["Standard_NC40ads_H100_v5", 7.0],
     "expect": {"outcome": "rejected", "reason": "not_an_object"}}
  ]
}
